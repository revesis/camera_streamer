<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WakeLock & Sensors -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" tools:ignore="HighSamplingRate" />

    <!-- Foreground Services -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Optional Camera module -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Boot completed for auto-start -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_sensor"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_sensor"
        android:supportsRtl="true"
        android:theme="@style/Theme.SensorAgent">

        <!-- Minimal Management Console UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sensor Streaming Foreground Service -->
        <service
            android:name=".service.SensorForegroundService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="camera|connectedDevice|dataSync">
            <intent-filter>
                <action android:name="com.antigravity.sensoragent.START" />
                <action android:name="com.antigravity.sensoragent.STOP" />
                <action android:name="com.antigravity.sensoragent.SWITCH_CAMERA" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile for One-Click Background Toggle -->
        <service
            android:name=".service.SensorTileService"
            android:exported="true"
            android:icon="@drawable/ic_sensor"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
